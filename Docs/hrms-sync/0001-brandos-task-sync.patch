diff --git a/brandos_sync_helper.php b/brandos_sync_helper.php
new file mode 100644
index 0000000..9e3f19c
--- /dev/null
+++ b/brandos_sync_helper.php
@@ -0,0 +1,38 @@
+<?php
+// Push an HRMS task's status change to the new Brand OS app, over HTTP, when that task was
+// created from a Brand OS deliverable (tasks.brandos_deliverable_id is set).
+//
+// This is separate from digiops_sync_helper.php, which talks to the OLD DigiOps product's
+// database directly. Brand OS is a different app on a different host, so it's called over its
+// own webhook instead — same "never break HRMS" defensiveness, just HTTP instead of a second PDO.
+function _brandos_task_sync(PDO $hrmsConn, int $hrmsTaskId, string $hrmsStatus): void {
+    $url    = $_ENV['BRANDOS_WEBHOOK_URL'] ?? '';
+    $secret = $_ENV['BRANDOS_WEBHOOK_SECRET'] ?? '';
+    if (!$url || !$secret) return; // not configured yet — silent no-op, same as digiops_db() absent
+
+    try {
+        $st = $hrmsConn->prepare('SELECT brandos_deliverable_id FROM tasks WHERE id = ?');
+        $st->execute([$hrmsTaskId]);
+        $deliverableId = $st->fetchColumn();
+        if (!$deliverableId) return; // this task didn't come from Brand OS
+
+        $payload = json_encode([
+            'secret' => $secret,
+            'deliverable_id' => (int)$deliverableId,
+            'status' => $hrmsStatus,
+        ]);
+        $ch = curl_init($url);
+        curl_setopt_array($ch, [
+            CURLOPT_CUSTOMREQUEST => 'POST',
+            CURLOPT_POSTFIELDS => $payload,
+            CURLOPT_HTTPHEADER => ['Content-Type: application/json'],
+            CURLOPT_RETURNTRANSFER => true,
+            CURLOPT_CONNECTTIMEOUT => 3,
+            CURLOPT_TIMEOUT => 5,
+        ]);
+        curl_exec($ch);
+        curl_close($ch);
+    } catch (Throwable $e) {
+        // Brand OS being down or misconfigured must never break HRMS's own status change.
+    }
+}
diff --git a/migrate_brandos_link.php b/migrate_brandos_link.php
new file mode 100644
index 0000000..d687078
--- /dev/null
+++ b/migrate_brandos_link.php
@@ -0,0 +1,20 @@
+<?php
+// Migration: Add brandos_deliverable_id to HRMS tasks table.
+// Links an HRMS task back to the Brand OS deliverable it was created from, so status changes
+// here can be pushed back via brandos_sync_helper.php.
+// Run once: http://localhost/hrms/php_implementation/migrate_brandos_link.php
+
+require_once 'config.php';
+
+try {
+    $check = $conn->query("SHOW COLUMNS FROM tasks LIKE 'brandos_deliverable_id'")->fetch();
+    if ($check) {
+        echo "✅ Column already exists — nothing to do.";
+    } else {
+        $conn->exec("ALTER TABLE tasks ADD COLUMN brandos_deliverable_id INT DEFAULT NULL");
+        $conn->exec("CREATE INDEX idx_tasks_brandos_deliverable ON tasks (brandos_deliverable_id)");
+        echo "✅ Added brandos_deliverable_id to tasks table.";
+    }
+} catch (Exception $e) {
+    echo "❌ Error: " . $e->getMessage();
+}
