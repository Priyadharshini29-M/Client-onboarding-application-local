new file mode 100644
index 0000000..1fa6065
--- /dev/null
+++ b/.env.brandos.example
@@ -0,0 +1,12 @@
+# ── Brand OS task sync ────────────────────────────────────────────────────
+# Append these lines to the real .env on the server (digihrms/.env).
+# Lets brandos_sync_helper.php push HRMS task status changes back to the new
+# Brand OS app whenever the task was created from a Brand OS deliverable
+# (tasks.brandos_deliverable_id is set — see migrate_brandos_link.php).
+#
+# BRANDOS_WEBHOOK_URL must point at Brand OS's own API, not the browser app:
+#   https://<brand-os-api-host>/webhooks/hrms-task-status
+# BRANDOS_WEBHOOK_SECRET must exactly match config('hrms.webhook_secret') in
+# Brand OS's api/config.php on that server.
+BRANDOS_WEBHOOK_URL=https://your-brandos-api-host/webhooks/hrms-task-status
+BRANDOS_WEBHOOK_SECRET=paste-the-same-value-as-brandos-config-hrms-webhook_secret
