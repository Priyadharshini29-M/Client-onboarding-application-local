{
  "name": "digiops",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm --prefix web run dev",
    "dev:api": "C:\\xampp\\php\\php.exe -S 127.0.0.1:8000 -t api/public api/public/index.php",
    "setup": "C:\\xampp\\php\\php.exe api/bin/setup.php",
    "setup:fresh": "C:\\xampp\\php\\php.exe api/bin/setup.php --fresh",
    "build": "npm --prefix web run build",
    "postinstall": "npm --prefix web install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
